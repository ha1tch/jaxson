  {
    "name": "sum-of-prices",
    "jaxson": "1.0",
    "input": {"items": [{"price": 10}, {"price": 20}, {"price": 30}]},
    "inputSchema": {"type": "object", "fields": {"items": {"type": "array", "items": {"type": "object", "fields": {"price": {"type": "number"}}, "required": ["price"]}}}, "required": ["items"]},
    "program": [
