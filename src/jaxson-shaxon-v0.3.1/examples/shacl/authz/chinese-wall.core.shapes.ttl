@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix ex:  <https://example.org/authz#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SHACL Core only: no sh:sparql, no SPARQL targets, no rules. The same data
# graph as chinese-wall.shapes.ttl (lift.py, unchanged): one root node with
# ex:events (ex:actor, ex:company), ex:companies (ex:id, ex:class, after the
# lift's rewrite of classOf) and ex:request (ex:actor, ex:company).
#
# The rule is: a request is refused if the actor has already touched a
# different company of the same class. Core has no existential quantifier over
# a join, so it is written as its contrapositive, a universal: every company
# record the actor has touched must be either the requested company or in a
# different class. The path walks from the request to the company records of
# the actor's events (the request itself matches too, which is harmless: it
# touches the requested company), and the value shape sits on a company
# record, where the class is a direct property that sh:equals can compare with
# the requested company's class, reached by a path back through the root.
ex:RequestShape a sh:NodeShape ;
    sh:targetObjectsOf ex:request ;
    sh:property ex:CONFLICTING_PRIOR_ACCESS .

ex:CONFLICTING_PRIOR_ACCESS a sh:PropertyShape ;
    sh:path ( ex:actor [ sh:inversePath ex:actor ] ex:company [ sh:inversePath ex:id ] ) ;
    sh:node ex:NoConflict ;
    sh:message "actor has already touched a different company in this conflict class" .

# A touched company record K is acceptable if it is not in the requested
# company's class, or if it is the requested company.
ex:NoConflict a sh:NodeShape ;
    sh:or (
        [ sh:not [ sh:property [
              sh:path ( [ sh:inversePath ex:companies ] ex:request ex:company
                        [ sh:inversePath ex:id ] ex:class ) ;
              sh:equals ex:class ] ] ]
        [ sh:property [
              sh:path ( [ sh:inversePath ex:companies ] ex:request ex:company ) ;
              sh:equals ex:id ] ]
    ) .

# Structure of the request, as the Shaxon package's closed Request shape
# states it.
ex:RequestStructure a sh:NodeShape ;
    sh:targetObjectsOf ex:request ;
    sh:closed true ;
    sh:ignoredProperties ( ) ;
    sh:property [ sh:path ex:actor ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ex:company ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .
