                "findings"
              ]
            }
          },
          "expr": [
            "eq",
            [
              "len",
              {
                "$v": "f"
              }
            ],
            0
          ]
        }
      },
      "then": [
        {
          "op": "check",
          "target": {
            "$path*": [
              "grantedBy"
            ],
            "from": [
              "input",
              "request",
              "grant"
            ],
            "maxDepth": 3
          },
          "shape": "LinkLive",
          "mode": "report",
          "into": [
            "state",
            "findings"
          ]
        },
        {
          "op": "check",
          "target": {
            "$path*": [
              "grantedBy"
            ],
            "from": [
              "input",
              "request",
              "grant"
            ],
            "maxDepth": 3
          },
          "shape": "LinkFresh",
          "mode": "report",
          "into": [
            "state",
            "findings"
          ]
        },
        {
          "op": "check",
          "target": {
            "$path*": [
              "grantedBy"
            ],
            "from": [
              "input",
              "request",
              "grant"
            ],
            "maxDepth": 3
          },
          "shape": "LinkBudget",
          "mode": "report",
          "into": [
            "state",
            "findings"
          ]
        },
        {
          "op": "check",
          "target": {
            "$path*": [
              "grantedBy"
            ],
            "from": [
              "input",
              "request",
              "grant"
            ],
            "maxDepth": 3
          },
          "shape": "LinkRooted",
          "mode": "report",
          "into": [
            "state",
            "findings"
          ]
        }
      ]
    },
    {
      "op": "set",
      "path": [
        "output"
      ],
      "value": {
        "$tpl": {
          "decision": {
            "$compute": {
              "with": {
                "f": {
                  "$path": [
                    "state",
                    "findings"
                  ]
                }
              },
              "expr": [
                "select",
                [
                  "eq",
                  [
                    "len",
                    {
                      "$v": "f"
                    }
                  ],
                  0
                ],
                "allow",
                "deny"
              ]
            }
          },
          "findings": {
            "$path": [
              "state",
              "findings"
            ]
          }
        }
      }
    }
  ]
}
